<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Pantry Ingredient"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/etIngredientName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Ingredient Name (e.g., Tomato, Egg)"
        android:inputType="textCapWords"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etQuantity"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Quantity (e.g., 3.0)"
        android:inputType="numberDecimal"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etUnit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Unit (e.g., units, grams, ml)"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etExpiryDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Expiry Date (Optional, e.g., 2026-12-31)"
        android:inputType="date"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnSaveIngredient"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Save to Pantry"/>

</LinearLayout>