<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Custom Recipe"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Recipe Name -->
        <EditText
            android:id="@+id/etCustomRecipeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Recipe Name (e.g., Veggie Stir Fry)"
            android:minHeight="48dp"
            android:inputType="textCapWords"
            android:layout_marginBottom="12dp"/>

        <!-- Instructions -->
        <EditText
            android:id="@+id/etCustomInstructions"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Step-by-step instructions..."
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Required Ingredients"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Ingredient Input Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etIngName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:minHeight="48dp"
                android:hint="Ingredient"
                android:inputType="text"/>

            <EditText
                android:id="@+id/etIngQty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:hint="Qty"
                android:inputType="numberDecimal"/>

            <EditText
                android:id="@+id/etIngUnit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:hint="Unit"
                android:inputType="text"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnAddIngredientToList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Ingredient to Recipe"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_marginBottom="12dp"/>

        <!-- Display Added Ingredients Summary -->
        <TextView
            android:id="@+id/tvAddedIngredientsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="No ingredients added yet."
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="24dp"/>

        <!-- Save Recipe Button -->
        <Button
            android:id="@+id/btnSaveCustomRecipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Recipe to Database" />

    </LinearLayout>
</ScrollView>